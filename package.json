{
  "name": "pi-secretary",
  "version": "0.2.0",
  "description": "Pi extension: Secretary/Router identity injection, role registry, role-based worker dispatch, and a Backlog-backed TDD gate",
  "keywords": [
    "pi-package",
    "pi-extension",
    "secretary",
    "router",
    "dispatch",
    "roles"
  ],
  "license": "MIT",
  "private": false,
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun test test/",
