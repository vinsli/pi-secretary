#!/bin/sh
# WF-002 P0.2 Secretary 启动器：以 Secretary/Router 提示词拉起主 pi 会话。
#
# 用法:
#   tools/workflow-secretary [--dry-run] [--] [额外 pi 参数...]
#
# 行为:
#   - 从项目根（脚本所在 tools/ 的上一级）启动主 pi，会话显示名 wf002-secretary；
#   - 经两个可重复的 `pi --append-system-prompt` 注入：先项目公共规则
#     `$PROJECT_ROOT/.pi/APPEND_SYSTEM.md`，再 Secretary 前台 + Router 引用与
#     “启动后先做一次 workflow status”的首查指令；
#   - 显式传参会替代 .pi/APPEND_SYSTEM.md 的自动发现，因此不能只传 Secretary
#     prompt，必须把公共规则文件显式列为第一个来源；
#   - 只启动主 session 本身，不自动派 Watchdog / Router child / 任何子代理；
#   - Backlog 读写只经全局 `backlog`（`-thu.` fork 版；公共规则层已内置该约束）。
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd) || exit 1
APPEND_SYSTEM_FILE="$PROJECT_ROOT/.pi/APPEND_SYSTEM.md"
PROMPT_FILE="$SCRIPT_DIR/workflow-secretary.prompt.md"

usage() {
    cat <<'EOF'
WF-002 Secretary 启动器

从项目根启动主 pi 会话，按顺序注入两个 --append-system-prompt：先
.pi/APPEND_SYSTEM.md（公共规则层），后 Secretary prompt（Secretary 唯一人机
前台 + Router 调度位身份层）；注入后该会话的第一件事是执行一次 workflow
status 冷启动检查。

用法:
  tools/workflow-secretary [--dry-run] [--] [额外 pi 参数...]

选项:
  --dry-run    只打印将执行的命令，不启动 pi
  --help, -h   显示本帮助
  --           之后的参数原样传给 pi（例如 -- --continue）

说明:
  - 显式注入两个 prompt 来源，顺序固定：先 .pi/APPEND_SYSTEM.md（公共
    规则），后 Secretary prompt（身份层）；显式传参会替代公共文件的自动发现，
    故缺一不可。
  - 已由本启动器注入的会话，再用项目扩展命令 /secretary on 不会双份（按
    身份标题去重）；/secretary off 只控制扩展自身，不能撤销本启动器已注入
    的内容或会话历史。运行中的普通 pi 会话可用 /secretary 就地开启同一份
    身份（on/off/status，无参默认 on；命令本身不触发模型请求）。
  - 只启动主 session，不自动派 Watchdog 或任何子代理。
  - Backlog 读写必须经全局 backlog（backlog --version 含 -thu.；
    禁止任何非 -thu. 版本）。
EOF
}

die() {
    printf 'workflow-secretary: %s\n' "$1" >&2
    exit 1
}

DRY_RUN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --help | -h)
            usage
            exit 0
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            continue
            ;;
        --)
            shift
            break
            ;;
        *)
            die "未知参数: $1（额外 pi 参数请放在 -- 之后；见 --help）"
            ;;
    esac
done
# 此处 "$@"（可能为空）= `--` 之后原样传给 pi 的额外参数。

[ -f "$APPEND_SYSTEM_FILE" ] || die "公共规则文件缺失: $APPEND_SYSTEM_FILE"
[ -r "$APPEND_SYSTEM_FILE" ] || die "公共规则文件不可读: $APPEND_SYSTEM_FILE"
[ -s "$APPEND_SYSTEM_FILE" ] || die "公共规则文件为空: $APPEND_SYSTEM_FILE"
[ -f "$PROMPT_FILE" ] || die "Secretary 提示词文件缺失: $PROMPT_FILE"
[ -r "$PROMPT_FILE" ] || die "Secretary 提示词文件不可读: $PROMPT_FILE"
[ -s "$PROMPT_FILE" ] || die "Secretary 提示词文件为空: $PROMPT_FILE"
command -v pi >/dev/null 2>&1 || die "PATH 中找不到 pi；请从装有 pi 的 Herdr pane / 终端启动"
[ -e "$PROJECT_ROOT/.git" ] || die "项目根检查失败（未找到 .git）: $PROJECT_ROOT"
command -v backlog >/dev/null 2>&1 || die "PATH 中找不到 backlog（需 ~/.local/bin/backlog，vinsli/Backlog.md fork）"
BACKLOG_VERSION=$(backlog --version 2>/dev/null || true)
case "$BACKLOG_VERSION" in
    *-thu.*) ;;
    *) die "backlog 不是 -thu. fork 版（backlog --version 需含 -thu.；当前: ${BACKLOG_VERSION:-<无输出>}）" ;;
esac

if [ "$DRY_RUN" -eq 1 ]; then
    printf '%s\n' "dry-run：不启动 pi。将执行："
    printf '  cd %s\n' "$PROJECT_ROOT"
    printf '  pi -n wf002-secretary --tools +secretary_schedule,+secretary_cancel,+secretary_subscribe,+secretary_runtime_status,+secretary_deadline --append-system-prompt "%s" --append-system-prompt "%s"' \
        "$APPEND_SYSTEM_FILE" "$PROMPT_FILE"
    if [ $# -gt 0 ]; then
        printf ' "%s"' "$@"
    fi
    printf '\n'
    exit 0
fi

cd "$PROJECT_ROOT"
exec pi -n wf002-secretary \
    --tools +secretary_schedule,+secretary_cancel,+secretary_subscribe,+secretary_runtime_status,+secretary_deadline \
    --append-system-prompt "$APPEND_SYSTEM_FILE" \
    --append-system-prompt "$PROMPT_FILE" \
    "$@"
